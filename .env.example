ANTHROPIC_API_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=KNOT

# ---- v2 설정 (비워 두면 v1과 똑같이 동작: 로그인 없음, 사용자 1명) ----
# 로그인을 켠다. 계정은 src 폴더에서 python -m scripts.accounts 로 만든다
AUTH_ENABLED=
# HTTPS 주소(Tailscale Funnel)로 열 때 1
COOKIE_SECURE=
# 빌드한 화면(frontend/dist)을 이 서버가 함께 내보낸다 (주소 하나로 열기)
SERVE_FRONTEND=
# 실패 처리(짧은 본문 재시도, 붙여넣기 분석, 메모 저장)를 켠다
FAILURE_ASSIST=
# 화면에 거는 링크
SOURCE_URL=https://github.com/zicMeteor/KNOT-PROJECT
SURVEY_URL=
# 상한 (기본값: 본문 30000자, PDF 20MB, 페이지 받기 15초)
MAX_TEXT_CHARS=
MAX_PDF_MB=
FETCH_TIMEOUT=
